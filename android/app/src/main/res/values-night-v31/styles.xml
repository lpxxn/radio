<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 启动底色保持与手机浅色播放页一致，避免深色系统模式下闪黑。 -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/radio_launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/radio_launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:statusBarColor">@color/radio_launch_background</item>
        <item name="android:navigationBarColor">@color/radio_launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
